{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/confeitaria-app/browser",

  "functions": {
    "api/**/*.js": {
      "maxDuration": 10
    }
  },

  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|assets/|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}